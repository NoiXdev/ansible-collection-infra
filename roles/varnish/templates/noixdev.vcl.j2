vcl 4.1;
# managed by noixdev.infra (varnish role). Changes here are overwritten.
# It holds the front key: root:varnish 0640, as varnishd reads it as varnish.
{#
  A cookie list as one regular expression of whole names: a trailing * means
  prefix; everything else is literal (names may hold "." and "-").
#}
{% macro cookie_regex(names) -%}
{%- set parts = [] -%}
{%- for name in names -%}
{%- set _ = parts.append((name[:-1] | regex_escape ~ '.*') if name.endswith('*') else name | regex_escape) -%}
{%- endfor -%}
^(?:{{ parts | join('|') }})$
{%- endmacro %}
{#
  Removes the query parameters of a list (whole names, with or without a
  value) and the separators they leave.
#}
{% macro strip_parameters(names) -%}
{%- set alternatives = names | map('regex_escape') | join('|') %}
    if (req.url ~ "[?&](?:{{ alternatives }})(?:=|&|$)") {
        set req.url = regsuball(req.url, "([?&])(?:{{ alternatives }})(?:=[^&]*)?(?=&|$)", "\1");
        set req.url = regsuball(req.url, "&{2,}", "&");
        set req.url = regsub(req.url, "\?&", "?");
        set req.url = regsub(req.url, "[?&]$", "");
    }
{%- endmacro %}
{#
  The condition "the request is for one of the sites named" (req or bereq).
#}
{% macro for_sites(scope, names) -%}
{%- for name in names %}{{ ' || ' if not loop.first }}{{ scope }}.http.X-Noix-Site == "{{ name }}"{% endfor -%}
{%- endmacro %}
{% set shopware_sites = varnish_sites_normalized | selectattr('profile', 'eq', 'shopware') | map(attribute='name') | list %}

import std;
import cookie;
import xkey;

# Varnish listens on 127.0.0.1 only; nothing else is answered.
acl noixdev_local {
    "127.0.0.1";
    "::1";
}

# nginx's inner server: the backend of every site without a health probe.
backend default {
    .host = "{{ varnish_backend_host }}";
    .port = "{{ varnish_backend_port }}";
    .connect_timeout = {{ varnish_connect_timeout }}s;
    .first_byte_timeout = {{ varnish_first_byte_timeout }}s;
    .between_bytes_timeout = {{ varnish_between_bytes_timeout }}s;
}
{% for site in varnish_sites_normalized if site.health_path != '' %}

# {{ site.name }}: the same inner server, with the site's health probe (through
# nginx and the app, so a dead PHP pool makes the site sick). Sick after 3
# failures of the last 5; healthy at the start.
backend site_{{ site.name }} {
    .host = "{{ varnish_backend_host }}";
    .port = "{{ varnish_backend_port }}";
    .connect_timeout = {{ varnish_connect_timeout }}s;
    .first_byte_timeout = {{ varnish_first_byte_timeout }}s;
    .between_bytes_timeout = {{ varnish_between_bytes_timeout }}s;
    .probe = {
        .request =
            "GET {{ site.health_path }} HTTP/1.1"
            "Host: {{ site.health_host }}"
            "X-Forwarded-Proto: https"
            "User-Agent: Varnish health probe"
            "Connection: close";
        .expected_response = 200;
        .interval = 5s;
        .timeout = 4s;
        .window = 5;
        .threshold = 3;
        .initial = 3;
    }
}
{% endfor %}

sub vcl_recv {
    if (client.ip !~ noixdev_local) {
        return (synth(403, "Forbidden"));
    }
    # The nginx role's probe of its front hop: through the WAF it reaches
    # Varnish without the front key. Answered here, without the key: never
    # the backend's, never cached.
    if ((req.method == "GET" || req.method == "HEAD") && req.url == "{{ varnish_front_probe_path }}") {
        return (synth(204, ""));
    }
    # Invalidation comes from an app or a deploy on the host, straight to this
    # port, never through nginx or the WAF (whatever sends the front key):
    # 403 with it, 401 without the site's token, 400 on invalid input.
    if (req.method == "PURGE" || req.method == "BAN") {
        if (req.http.X-Noix-Front) {
            return (synth(403, "Forbidden"));
        }
        call noixdev_invalidate;
    }
    # nginx's public servers send the front key and the site (X-Noix-Site),
    # overwriting what the client sent; any other process on the host gets
    # 403. The backend never sees the key.
    if (req.http.X-Noix-Front != "{{ varnish_front_key }}") {
        return (synth(403, "Forbidden"));
    }
    unset req.http.X-Noix-Front;
    # A WebSocket upgrade goes to the backend as a pipe (a pass would drop
    # its Upgrade): only behind the front key, never cached. The pipe ends
    # with the connection, which nginx and the WAF never reuse.
    if (req.http.Upgrade ~ "(?i)websocket") {
        return (pipe);
    }
    call noixdev_normalize;
    call noixdev_site_recv;
    # A site that is not in varnish_sites: never cached.
    return (pass);
}

# One cache key per page: the host in lower case without a port, the query
# without the tracking parameters of every profile
# (varnish_tracking_parameters_common) and sorted.
sub noixdev_normalize {
    if (req.http.host) {
        set req.http.host = std.tolower(regsub(req.http.host, ":[0-9]+$", ""));
    }
{{ strip_parameters(varnish_tracking_parameters_common) }}
    set req.url = std.querysort(req.url);
}
{% if shopware_sites | length > 0 %}

# The shopware profile also removes the rest of Shopware's list
# (varnish_tracking_parameters_shopware); the query stays sorted.
sub noixdev_shopware_normalize {
{{ strip_parameters(varnish_tracking_parameters_shopware) }}
}

# The shopware profile's request rules: Shopware 6.7's VCL
# (shopware/varnish-shopware, 6.7/rootfs/etc/varnish/default.vcl at 518efcf,
# read 2026-11-20) in the role's frame. A cookie does not make the request
# pass: Shopware names the variant of a page in its cookies sw-cache-hash
# (else sw-currency), and the visitor's states (logged-in, cart-filled) in
# sw-states, which make a hit pass when the object's sw-invalidation-states
# names them (vcl_hit). They are read here, before any cookie is stripped.
# (Only with shopware sites: an unused sub does not compile.)
sub noixdev_shopware_recv {
    if (req.method != "GET" && req.method != "HEAD") {
        return (pass);
    }
    if (req.http.Authorization) {
        return (pass);
    }
    # Never cached (Shopware's list); with a query too.
    if (req.url ~ "^/(?:checkout|account|admin|api)(?:[/?].*)?$") {
        return (pass);
    }
    # Assets need no cookie: one object for every visitor, and the backend
    # gets none.
    if (req.url ~ "^/(?:media|thumbnail|theme|bundles)/") {
        unset req.http.Cookie;
    }
    cookie.parse(req.http.Cookie);
    # A sw-cache-hash request header wins over the cookie (Shopware's rule).
    if (!req.http.sw-cache-hash) {
        set req.http.sw-cache-hash = cookie.get("sw-cache-hash");
    }
    set req.http.X-Noix-Sw-Currency = cookie.get("sw-currency");
    set req.http.X-Noix-Sw-States = cookie.get("sw-states");
    # The cart widget of a visitor without a context or with an empty cart:
    # nothing to show, answered here.
    if (req.url == "/widgets/checkout/info"
        && (req.http.sw-cache-hash == ""
            || (cookie.isset("sw-states") && req.http.X-Noix-Sw-States !~ "cart-filled"))) {
        return (synth(204, ""));
    }
    # The app sends ESI to Varnish only when asked.
    set req.http.Surrogate-Capability = "shopware=ESI/1.0";
}
{% endif %}

# The site whose token an invalidation carries: Basic auth with the site's
# name and token, or X-Noix-Site and X-Purge-Token. Anything else (a site that
# is not in varnish_sites, too) gets 401. The comparisons log nothing, and no
# answer holds a token.
sub noixdev_invalidate {
{% for site in varnish_sites_normalized %}
    if (req.http.Authorization == "Basic {{ (site.name ~ ':' ~ site.purge_token) | b64encode }}"
        || (req.http.X-Noix-Site == "{{ site.name }}" && req.http.X-Purge-Token == "{{ site.purge_token }}")) {
        set req.http.X-Noix-Site = "{{ site.name }}";
        # A URL to purge is normalized as the stored ones are (X-Noix-Url).
        if (req.method == "PURGE") {
            call noixdev_normalize;
{% if site.profile == 'shopware' %}
            call noixdev_shopware_normalize;
{% endif %}
        }
        call noixdev_invalidate_site;
    }
{% endfor %}
    return (synth(401, "Unauthorized"));
}
{% if varnish_sites_normalized | length > 0 %}

# The invalidation of the site in X-Noix-Site (noixdev_invalidate), on that
# site's objects only: every ban starts with its X-Noix-Site, and xkey tags
# are stored and purged as <site>:<tag>. A ban from VCL takes no quotes (its
# words are split at whitespace), so the input is checked before it goes into
# a ban, and 400 answers what fails the check or what Varnish refuses: a URL
# has no quote, backslash, space or control character; a regular expression
# (BAN, X-Cache-Tags) takes A-Za-z0-9_.:;,|/*+?^$()[]{}\- only, at most 1024
# of them; xkey takes tags of A-Za-z0-9_.:- (at most 256 each), one space
# apart. (Only with sites: an unused sub does not compile.)
sub noixdev_invalidate_site {
    if (req.method == "PURGE") {
        # An empty header counts: it is invalid input, not a URL purge.
        if (req.http.xkey || req.http.xkey == "") {
            if (req.http.xkey !~ "^[A-Za-z0-9_.:-]{1,256}(?: [A-Za-z0-9_.:-]{1,256})*$") {
                return (synth(400, "Bad Request"));
            }
            # The number of objects purged, for varnishlog.
            set req.http.X-Noix-Purged = xkey.purge(regsuball(req.http.xkey, "([^ ]+)", req.http.X-Noix-Site + ":\1"));
            return (synth(200, "Purged"));
        }
        # The URL on every host of the site.
        if (req.url !~ "^/[!#-\[\]-~]*$") {
            return (synth(400, "Bad Request"));
        }
        if (!std.ban("obj.http.X-Noix-Site == " + req.http.X-Noix-Site + " && obj.http.X-Noix-Url == " + req.url)) {
            return (synth(400, "Bad Request"));
        }
        return (synth(200, "Purged"));
    }
    if (req.http.X-Cache-Tags || req.http.X-Cache-Tags == "") {
        if (req.http.X-Cache-Tags !~ "^[A-Za-z0-9_.:;,|/*+?^$()\[\]{}\\-]{1,1024}$") {
            return (synth(400, "Bad Request"));
        }
        if (!std.ban("obj.http.X-Noix-Site == " + req.http.X-Noix-Site + " && obj.http.X-Cache-Tags ~ " + req.http.X-Cache-Tags)) {
            return (synth(400, "Bad Request"));
        }
        return (synth(200, "Banned"));
    }
    if (req.url !~ "^[A-Za-z0-9_.:;,|/*+?^$()\[\]{}\\-]{1,1024}$") {
        return (synth(400, "Bad Request"));
    }
    if (!std.ban("obj.http.X-Noix-Site == " + req.http.X-Noix-Site + " && obj.http.X-Noix-Url ~ " + req.url)) {
        return (synth(400, "Bad Request"));
    }
    return (synth(200, "Banned"));
}
{% endif %}

# One block per site of varnish_sites; a request for another site passes
# (vcl_recv). Each block ends in noixdev_lookup, which passes or looks up
# (shopware: noixdev_shopware_recv passes, noixdev_hash looks up).
sub noixdev_site_recv {
{% for site in varnish_sites_normalized %}
{% set strip = varnish_strip_cookies + site.strip_cookies %}
    if (req.http.X-Noix-Site == "{{ site.name }}") {
        # {{ site.name }}: {{ site.profile }}
{% if site.health_path != '' %}
        set req.backend_hint = site_{{ site.name }};
{% endif %}
{% if site.profile == 'shopware' %}
        call noixdev_shopware_normalize;
        call noixdev_shopware_recv;
{% endif %}
{% if site.profile == 'typo3' %}
        # TYPO3's sessions (frontend and backend user) always pass, even if
        # strip_cookies names them.
        if (req.http.Cookie ~ "(?:^|;) *(?:fe_typo_user|be_typo_user)=") {
            return (pass);
        }
{% endif %}
{% if strip | length > 0 %}
        if (req.http.Cookie) {
            cookie.parse(req.http.Cookie);
            cookie.filter_re("{{ cookie_regex(strip) }}");
            set req.http.Cookie = cookie.get_string();
            if (req.http.Cookie == "") {
                unset req.http.Cookie;
            }
        }
{% endif %}
{% if site.profile == 'shopware' %}
        # Looked up with the remaining cookies (noixdev_shopware_recv).
        call noixdev_hash;
{% else %}
        call noixdev_lookup;
{% endif %}
    }
{% endfor %}
}

{% if varnish_sites_normalized | rejectattr('profile', 'eq', 'shopware') | list | length > 0 %}
# GET and HEAD without Authorization and without any cookie (after the
# stripping) are looked up; everything else passes. (Only with sites of
# another profile than shopware: an unused sub does not compile.)
sub noixdev_lookup {
    if (req.method != "GET" && req.method != "HEAD") {
        return (pass);
    }
    if (req.http.Authorization || req.http.Cookie) {
        return (pass);
    }
    call noixdev_hash;
}

{% endif %}
{% if varnish_sites_normalized | length > 0 %}
# The lookup. A stale object is served (and refreshed in the background) for
# varnish_grace_healthy while the site's backend is healthy, for
# varnish_grace_sick while its probe says sick.
sub noixdev_hash {
    if (std.healthy(req.backend_hint)) {
        set req.grace = {{ varnish_grace_healthy }}s;
    } else {
        set req.grace = {{ varnish_grace_sick }}s;
    }
    return (hash);
}
{% endif %}

# The pipe of a WebSocket upgrade keeps the hop-by-hop headers the backend
# needs (Varnish would close the connection after one answer otherwise).
sub vcl_pipe {
    if (req.http.Upgrade) {
        set bereq.http.Upgrade = req.http.Upgrade;
        set bereq.http.Connection = req.http.Connection;
    }
}

# The site is part of the key: two sites never share an object.
sub vcl_hash {
    hash_data(req.http.X-Noix-Site);
    hash_data(req.http.host);
    hash_data(req.url);
{% if shopware_sites | length > 0 %}
    # The shopware profile: Shopware's variant of the page (its context hash,
    # else the currency).
    if ({{ for_sites('req', shopware_sites) }}) {
        if (req.http.sw-cache-hash != "") {
            hash_data("+context=" + req.http.sw-cache-hash);
        } elsif (req.http.X-Noix-Sw-Currency != "") {
            hash_data("+currency=" + req.http.X-Noix-Sw-Currency);
        }
    }
{% endif %}
    return (lookup);
}
{% if shopware_sites | length > 0 %}

# The shopware profile: a logged-in visitor or one with a filled cart does
# not get an object the app marked as changing with that state
# (sw-invalidation-states).
sub vcl_hit {
    if (({{ for_sites('req', shopware_sites) }}) && req.http.X-Noix-Sw-States) {
        if (req.http.X-Noix-Sw-States ~ "logged-in" && obj.http.sw-invalidation-states ~ "logged-in") {
            return (pass);
        }
        if (req.http.X-Noix-Sw-States ~ "cart-filled" && obj.http.sw-invalidation-states ~ "cart-filled") {
            return (pass);
        }
    }
}

# The shopware profile's internal headers never reach the backend.
sub vcl_backend_fetch {
    if ({{ for_sites('bereq', shopware_sites) }}) {
        unset bereq.http.X-Noix-Sw-Currency;
        unset bereq.http.X-Noix-Sw-States;
    }
}
{% endif %}

sub vcl_backend_response {
    # What a ban selects objects by: the site, the host and the URL as
    # normalized (an app's own headers of these names are overwritten).
    set beresp.http.X-Noix-Site = bereq.http.X-Noix-Site;
    set beresp.http.X-Noix-Host = bereq.http.host;
    set beresp.http.X-Noix-Url = bereq.url;
    # The xkey tags are the site's own (<site>:<tag>), so no other site can
    # purge them; xkey's other header is not taken from the app.
    unset beresp.http.X-HashTwo;
    if (beresp.http.xkey) {
        std.collect(beresp.http.xkey);
        set beresp.http.xkey = regsuball(beresp.http.xkey, "([^\s,]+)", bereq.http.X-Noix-Site + ":\1");
    }
    # Every object has X-Cache-Tags (empty without tags): the ban of the tags
    # .* takes every object of the site.
    if (!beresp.http.X-Cache-Tags) {
        set beresp.http.X-Cache-Tags = "";
    }
{% if shopware_sites | length > 0 %}
    call noixdev_shopware_backend_response;
{% endif %}
    if (bereq.uncacheable) {
        return (deliver);
    }
    if (beresp.status >= 500) {
        # A failed background refresh keeps the stale object.
        if (bereq.is_bgfetch) {
            return (abandon);
        }
        call noixdev_hit_for_miss;
    }
    # A session start is never shared.
    if (beresp.http.Set-Cookie || beresp.http.Vary == "*") {
        call noixdev_hit_for_miss;
    }
    # Varnish's default TTL never applies: without max-age or s-maxage in
    # Cache-Control and without Expires the app did not make the response
    # cacheable.
    if (!beresp.http.Expires && beresp.http.Cache-Control !~ "(?i)(?:^|[,\s])(?:s-maxage|max-age)\s*=") {
        set beresp.ttl = 0s;
    }
    call noixdev_site_backend_response;
    # What the app made cacheable is cached for the app's TTL (s-maxage,
    # max-age or Expires).
    if (beresp.ttl <= 0s
        || beresp.http.Surrogate-Control ~ "(?i)no-store"
        || (!beresp.http.Surrogate-Control && beresp.http.Cache-Control ~ "(?i)(?:private|no-cache|no-store)")) {
        call noixdev_hit_for_miss;
    }
    set beresp.grace = {{ varnish_grace_sick }}s;
    return (deliver);
}

# Not stored: the requests for the URL go to the backend for a while (without
# waiting for each other), until it answers with something cacheable.
sub noixdev_hit_for_miss {
    set beresp.uncacheable = true;
    set beresp.ttl = 10s;
    set beresp.grace = 0s;
    return (deliver);
}
{% if shopware_sites | length > 0 %}

# The shopware profile's response rules (Shopware 6.7's VCL), before any
# other rule ends the response: ESI is processed on passes too, and a page
# the app marks with sw-dynamic-cache-bypass is not stored, for 1 s only (a
# 5xx stays with the 5xx rule, so a failed background refresh keeps the
# stale object). The role's rules stay: Set-Cookie, 5xx and responses without
# a TTL are not stored, and the grace is the role's.
sub noixdev_shopware_backend_response {
    if ({{ for_sites('bereq', shopware_sites) }}) {
        unset beresp.http.X-Powered-By;
        unset beresp.http.Server;
        if (beresp.http.Surrogate-Control ~ "ESI/1.0") {
            unset beresp.http.Surrogate-Control;
            set beresp.do_esi = true;
        }
        if (beresp.http.sw-dynamic-cache-bypass == "1" && beresp.status < 500) {
            unset beresp.http.sw-dynamic-cache-bypass;
            set beresp.uncacheable = true;
            set beresp.ttl = 1s;
            set beresp.grace = 0s;
            return (deliver);
        }
        if (bereq.url ~ "\.js$" || beresp.http.Content-Type ~ "text") {
            set beresp.do_gzip = true;
        }
    }
}
{% endif %}

# The microcache: a 200, 301 or 404 the app did not make cacheable (private,
# no-cache, no-store, no TTL) is kept for the site's microcache seconds, and
# not served stale beyond them.
sub noixdev_site_backend_response {
{% for site in varnish_sites_normalized if site.microcache | int > 0 %}
    if (bereq.http.X-Noix-Site == "{{ site.name }}"
        && (beresp.status == 200 || beresp.status == 301 || beresp.status == 404)
        && (beresp.ttl <= 0s || beresp.http.Cache-Control ~ "(?i)(?:private|no-cache|no-store)")) {
        set beresp.ttl = {{ site.microcache | int }}s;
        set beresp.grace = 0s;
        return (deliver);
    }
{% endfor %}
}

# A background refresh that cannot reach the backend (sick, refused, timed
# out) keeps the stale object.
sub vcl_backend_error {
    if (bereq.is_bgfetch) {
        return (abandon);
    }
}

# X-Noix-Cache tells nginx the cache status (for its log); nginx removes it.
# "+grace": a stale object was served. The headers bans and tags use stay in
# the cache, and so do Shopware's invalidation states on every profile.
sub vcl_deliver {
    if (obj.uncacheable) {
        set resp.http.X-Noix-Cache = "PASS";
    } elsif (obj.hits > 0) {
        set resp.http.X-Noix-Cache = "HIT";
    } else {
        set resp.http.X-Noix-Cache = "MISS";
    }
    if (obj.hits > 0 && obj.ttl <= 0s) {
        set resp.http.X-Noix-Cache = resp.http.X-Noix-Cache + "+grace";
    }
    call noixdev_debug_header;
{% if shopware_sites | length > 0 %}
    call noixdev_shopware_deliver;
{% endif %}
    unset resp.http.X-Noix-Site;
    unset resp.http.X-Noix-Host;
    unset resp.http.X-Noix-Url;
    unset resp.http.xkey;
    unset resp.http.X-Cache-Tags;
    unset resp.http.sw-invalidation-states;
    unset resp.http.Via;
    unset resp.http.X-Varnish;
}
{% if shopware_sites | length > 0 %}

# The shopware profile (Shopware 6.7's VCL): browsers keep no page, only the
# assets and store-api answers, as the app sent them; Shopware's Link header
# stays inside.
sub noixdev_shopware_deliver {
    if ({{ for_sites('req', shopware_sites) }}) {
        if (resp.http.Cache-Control !~ "private" && req.url !~ "^/(?:theme|media|thumbnail|bundles|store-api)/") {
            set resp.http.Pragma = "no-cache";
            set resp.http.Expires = "-1";
            set resp.http.Cache-Control = "no-store, no-cache, must-revalidate, max-age=0";
        }
        unset resp.http.Link;
    }
}
{% endif %}

sub vcl_synth {
    set resp.http.X-Noix-Cache = "SYNTH";
    if (resp.status == 401) {
        set resp.http.WWW-Authenticate = {"Basic realm="invalidation""};
    }
    call noixdev_debug_header;
    unset resp.http.Via;
    unset resp.http.X-Varnish;
}

# X-Cache (the same as X-Noix-Cache) for the sites with debug_header.
sub noixdev_debug_header {
{% set debug_sites = varnish_sites_normalized | selectattr('debug_header') | map(attribute='name') | list %}
{% if debug_sites | length > 0 %}
    if ({% for name in debug_sites %}{{ ' || ' if not loop.first }}req.http.X-Noix-Site == "{{ name }}"{% endfor %}) {
        set resp.http.X-Cache = resp.http.X-Noix-Cache;
    } else {
        unset resp.http.X-Cache;
    }
{% else %}
    unset resp.http.X-Cache;
{% endif %}
}
