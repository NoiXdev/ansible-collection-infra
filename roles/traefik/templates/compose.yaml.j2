# {{ ansible_managed }}
services:
  socket-proxy:
    image: {{ traefik_socket_proxy_image }}
    environment:
      CONTAINERS: "1"
      NETWORKS: "1"
      POST: "0"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks: [socket]
    restart: unless-stopped

  traefik:
    image: {{ traefik_image }}
    depends_on: [socket-proxy]
    env_file: [dns.env]
    ports:
{% for ep in traefik_entrypoints %}
{% set suffix = '/udp' if ep.protocol | default('tcp') == 'udp' else '' %}
{% for addr in ep.bind | default([]) %}
      - "{{ addr }}:{{ ep.host_port | default(ep.port) }}:{{ ep.port }}{{ suffix }}"
{% else %}
      - "{{ ep.host_port | default(ep.port) }}:{{ ep.port }}{{ suffix }}"
{% endfor %}
{% endfor %}
    volumes:
      - ./traefik.yml:/etc/traefik/traefik.yml:ro
      - ./dynamic:/etc/traefik/dynamic:ro
      - ./acme:/acme
    networks:
      socket: {}
      proxy:
        ipv4_address: {{ traefik_address }}
    restart: unless-stopped
{% if traefik_error_pages_enabled and traefik_error_pages_container %}

  error-pages:
    image: {{ traefik_error_pages_image }}
    user: "65532:65532"
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
{% if traefik_error_pages_env | length > 0 %}
    environment:
{% for key, value in traefik_error_pages_env.items() %}
      {{ key }}: {{ value | string | to_json }}
{% endfor %}
{% endif %}
    volumes:
      # Maintenance flag (/error-pages maintenance on|off).
      - error-pages-data:/data
    networks:
      proxy:
        aliases: [error-pages]
    deploy:
      resources:
        limits:
          cpus: "{{ traefik_error_pages_cpus }}"
          memory: {{ traefik_error_pages_memory }}
          pids: 64
    restart: unless-stopped
{% endif %}

networks:
  socket:
    internal: true
    driver_opts:
      com.docker.network.driver.mtu: "{{ traefik_mtu }}"
  proxy:
    name: {{ traefik_network }}
    driver_opts:
      com.docker.network.driver.mtu: "{{ traefik_mtu }}"
    ipam:
      config:
        - subnet: {{ traefik_network_subnet }}
          ip_range: {{ traefik_network_range }}
{% if traefik_error_pages_enabled and traefik_error_pages_container %}

volumes:
  error-pages-data: {}
{% endif %}
