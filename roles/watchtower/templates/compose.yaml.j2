{#- Values go through q: to_json (a valid YAML string) with $ doubled, which
    compose would otherwise interpolate. -#}
{%- macro q(value) -%}{{ (value | string | replace('$', '$$')) | to_json }}{%- endmacro -%}
# {{ ansible_managed }}
{% set watchtower_with_config = watchtower_registry_dir.stat.isdir | default(false) %}
services:
  watchtower:
    image: {{ watchtower_image }}:{{ watchtower_version }}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
{% if watchtower_with_config %}
      - {{ q(watchtower_registry_config_dir ~ ':/config:ro') }}
{% endif %}
    environment:
      TZ: {{ q(watchtower_tz) }}
      WATCHTOWER_SCHEDULE: {{ q(watchtower_schedule) }}
      WATCHTOWER_LABEL_ENABLE: "{{ watchtower_label_enable | bool | lower }}"
      WATCHTOWER_CLEANUP: "{{ watchtower_cleanup | bool | lower }}"
      WATCHTOWER_INCLUDE_STOPPED: "{{ watchtower_include_stopped | bool | lower }}"
{% if watchtower_notification_url | length > 0 %}
      WATCHTOWER_NOTIFICATION_URL: {{ q(watchtower_notification_url) }}
{% endif %}
{% if watchtower_with_config %}
      DOCKER_CONFIG: /config
{% endif %}
{% for key in watchtower_env | sort %}
      {{ key }}: {{ q(watchtower_env[key]) }}
{% endfor %}
    cpus: "{{ watchtower_cpus }}"
    mem_limit: {{ watchtower_memory }}
    restart: unless-stopped

networks:
  default:
    driver_opts:
      com.docker.network.driver.mtu: "{{ watchtower_mtu }}"
