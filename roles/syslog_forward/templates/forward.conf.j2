# Written by the noixdev.infra.syslog_forward role; changes here are
# overwritten. What rsyslog receives, as RFC 5424, to each target; a TCP
# target queues while its receiver is down (queue.size messages in memory,
# then up to queue.maxDiskSpace on disk), and a full queue drops new
# messages at once rather than hold up local logging.
{% for target in syslog_forward_targets %}
{%   set name = 'noixdev-forward-' ~ loop.index %}
{%   set protocol = target.protocol | default('tcp') %}
{{ syslog_forward_filter }} action(type="omfwd" name="{{ name }}"
    target="{{ target.host }}" port="{{ target.port | default(514) }}" protocol="{{ protocol }}"
    template="RSYSLOG_SyslogProtocol23Format"
{%   if protocol == 'tcp' %}
    queue.type="LinkedList" queue.filename="{{ name }}" queue.size="{{ target.queue_size | default(10000) }}"
    queue.maxDiskSpace="{{ target.queue_max_disk | default('512m') }}"
    queue.saveOnShutdown="on" queue.timeoutEnqueue="0" action.resumeRetryCount="-1"
{%   endif %}
{%   if target.tls | default(false) %}
    StreamDriver="gtls" StreamDriverMode="1" StreamDriverAuthMode="x509/name"
    StreamDriverPermittedPeers="{{ target.host }}"
    StreamDriver.CAFile="{{ target.ca_file | default('', true) or syslog_forward_system_ca }}"
{%   endif %}
)
{% endfor %}
