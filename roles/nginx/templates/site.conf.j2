{#
  One site (nginx_site: the site from nginx_sites_public, with tls_files, the
  certificate and key of its TLS block, or {} while it has none). Without a
  front hop (site.front empty) the public server block serves the content
  itself (content(site, false)). With one, the public block runs the checks
  and sends every request to site.front (the WAF, else Varnish: with the
  inner block as the backup while Varnish does not answer); an inner server
  block on 127.0.0.1:nginx_inner_port, which only the front hop reaches,
  serves the content (content(site, true)).
#}
{% set site = nginx_site %}
{% set https = site.tls_files | length > 0 %}
{% set scheme = 'http' if site.tls == 'off' else 'https' %}
{% set canonical = site.domains[0] %}
{# The headers: the hardening's, then the site's (by name, in any case); an
   empty value removes one. #}
{% set ns = namespace(headers=[]) %}
{% set own = site.headers | dict2items %}
{% set own_names = own | map(attribute='key') | map('lower') | list %}
{% if site.hardening %}
{%   set defaults = [['X-Content-Type-Options', 'nosniff'], ['Referrer-Policy', 'strict-origin-when-cross-origin'], ['X-Frame-Options', 'SAMEORIGIN']] %}
{%   if site.hsts and https %}
{%     set defaults = defaults + [['Strict-Transport-Security', 'max-age=31536000']] %}
{%   endif %}
{%   for header in defaults if header[0] | lower not in own_names %}
{%     set ns.headers = ns.headers + [header] %}
{%   endfor %}
{% endif %}
{% for header in own if header.value | length > 0 %}
{%   set ns.headers = ns.headers + [[header.key, header.value]] %}
{% endfor %}
{# The macros' lines are unindented; each call indents them. #}
{% macro listen(port, ssl) %}
listen {{ port }}{{ ' ssl' if ssl else '' }};
{% if nginx_ipv6 %}
listen [::]:{{ port }}{{ ' ssl' if ssl else '' }};
{% endif %}
{% if ssl %}
http2 on;
ssl_certificate {{ site.tls_files.cert }};
ssl_certificate_key {{ site.tls_files.key }};
{% if site.tls is mapping %}
ssl_stapling on;
ssl_stapling_verify on;
{% if nginx_resolvers | length > 0 %}
resolver {{ nginx_resolvers | join(' ') }} valid=300s;
resolver_timeout 5s;
{% endif %}
{% endif %}
{% endif %}
{% endmacro %}
{# Before the redirect: a prefix match with ^~ wins over every regex
   location. The challenge root is root's, and these port 80 blocks have no
   disable_symlinks (only a site's own server block has, for its root). #}
{% macro acme() %}
# ACME http-01 challenges (certbot's webroot).
location ^~ /.well-known/acme-challenge/ {
    root {{ nginx_acme_root }};
    default_type text/plain;
    try_files $uri =404;
}
{% endmacro %}
{# A varnish site's lines have Varnish's cache status too (cache=). #}
{% macro logs() %}
access_log /var/log/nginx/{{ site.name }}.access.log {{ 'varnish' if site.varnish else 'main' }};
error_log /var/log/nginx/{{ site.name }}.error.log;
{% endmacro %}
{% macro root(site) %}
root {{ site.root }};
# www-data is in every site's group: a link to a file of another owner
# (another environment's, say) is not followed, in every part of the
# path, the root's own path too (a site user's link current re-pointed
# at another site's tree). A deploy's current -> releases/N works when
# the site user owns the link and the release.
disable_symlinks if_not_owner;
index {{ (site.php_front_controller ~ ' ') if site.php_pool is defined else '' }}index.html;
{% endmacro %}
{# inner: the inner block, which has no Basic auth and no Anubis. #}
{% macro error_pages(site, inner) %}
# The noix error pages, for the errors nginx answers itself; the app's
# own answers pass unchanged (no fastcgi_intercept_errors or
# proxy_intercept_errors). ^~: no regex location (the hardening's
# dotfiles) takes the path. The release behind the link current is
# root's, as the link is: disable_symlinks if_not_owner follows it.
{% for code in nginx_error_pages_codes | map('int') | unique | sort %}
error_page {{ code }} /.noix-error/{{ code }}.html;
{% endfor %}
location ^~ /.noix-error/ {
    internal;
{% if site.basic_auth_on and not inner %}
    # The page of an error before the login (a rate limit) needs none.
    auth_basic off;
    allow all;
{% endif %}
{% if site.anubis and not inner %}
    # The page of a 403 (Anubis's DENY) or a 500 (Anubis down) is never
    # checked again.
    auth_request off;
{% endif %}
    # The redirect to the page keeps the request's headers: without this
    # a 413 (body too large) fails again here and nginx shows its own.
    client_max_body_size 0;
    alias {{ nginx_error_pages_dir }}/current/pages/{{ nginx_error_pages_lang }}/;
}
{% endmacro %}
{% macro anubis() %}
# Anubis (the anubis role in host mode, {{ nginx_anubis_url }}): every
# request of this server is checked before its location runs; a browser
# without Anubis's cookie gets the challenge page at the URL it asked
# for (status 401), which leads back there once solved. What nginx
# answers before the check (the hardening's 404s, redirects) is never
# checked. Anubis decides the paths its policy ALLOWs too: while it is
# down every checked request answers 500 (fails closed). nginx sets
# X-Original-Uri, X-Forwarded-Uri and X-Real-Ip itself (X-Real-Ip is
# $remote_addr, the address nginx_real_ip_from yields), so a client's
# own never reach Anubis.
auth_request /.within.website/x/cmd/anubis/api/check;
error_page 401 @anubis_challenge;

# The check. It carries no body; without client_max_body_size 0 nginx
# would hold the request's Content-Length against this location (413,
# so 500).
location = /.within.website/x/cmd/anubis/api/check {
    internal;
    client_max_body_size 0;
    proxy_pass {{ nginx_anubis_url }};
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Host $host;
    proxy_set_header X-Original-Uri $request_uri;
    proxy_set_header X-Forwarded-Uri $request_uri;
    proxy_set_header X-Real-Ip $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_connect_timeout 5s;
    proxy_read_timeout 10s;
}

# Anubis's own paths (its assets, pass-challenge), never checked. No
# X-Original-Uri or X-Forwarded-Uri: Anubis judges the path it is asked
# for. ^~: no regex location (the hardening's dotfiles) takes the path.
location ^~ /.within.website/ {
    auth_request off;
    proxy_pass {{ nginx_anubis_url }};
    proxy_set_header Host $host;
    proxy_set_header X-Original-Uri "";
    proxy_set_header X-Forwarded-Uri "";
    proxy_set_header X-Real-Ip $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_connect_timeout 5s;
}

# The challenge: Anubis renders its page for the request as sent (a GET,
# without the body); the status stays 401, so no cache keeps the page as
# the URL's content.
location @anubis_challenge {
    auth_request off;
    proxy_method GET;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Host $host;
    proxy_set_header X-Original-Uri "";
    proxy_set_header X-Forwarded-Uri "";
    proxy_set_header X-Real-Ip $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_connect_timeout 5s;
    proxy_pass {{ nginx_anubis_url }};
}

# ACME challenges (certbot's webroot) are never checked, here as on port
# 80.
location ^~ /.well-known/acme-challenge/ {
    auth_request off;
    root {{ nginx_acme_root }};
    default_type text/plain;
    try_files $uri =404;
}
{% endmacro %}
{#
  The site's content and the error pages: in the public block without a
  front hop (inner false), with the site's Anubis and extra; in the inner
  block (inner true), with inner_extra. The inner block gets the public
  block's scheme and port for PHP, and passes the public block's
  X-Forwarded-* to a proxy backend unchanged, never its own hop's. Each
  part starts with an empty line.
#}
{% macro content(site, inner) %}
{% set https = site.tls_files | length > 0 %}
{% if nginx_error_pages %}

{{ error_pages(site, inner) | trim }}
{% endif %}
{% if not inner and site.anubis %}

{{ anubis() | trim }}
{% endif %}
{% if not inner and site.extra | length > 0 %}

# extra
{{ site.extra }}
{% endif %}
{% if inner and site.inner_extra | length > 0 %}

# inner_extra
{{ site.inner_extra }}
{% endif %}
{% if site.php_pool is defined %}

# Only the front controller and the listed scripts go to PHP.
{% for script in [site.php_front_controller] + site.php_scripts %}
location = /{{ script }} {
    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
    fastcgi_param DOCUMENT_ROOT $realpath_root;
    fastcgi_param HTTP_PROXY "";
{% if inner %}
    # The front key (here when Varnish was skipped: the backup, the WAF's
    # fallback) never reaches the app.
    fastcgi_param HTTP_X_NOIX_FRONT "";
    # The public block's port (and HTTPS), not this hop's.
    fastcgi_param SERVER_PORT {{ 443 if https else 80 }};
{% if https %}
    fastcgi_param HTTPS on;
    fastcgi_param REQUEST_SCHEME https;
{% endif %}
{% endif %}
    fastcgi_pass unix:/run/php/{{ site.php_pool }}.sock;
}

{% endfor %}
# Any other PHP file is never run and never served as text.
location ~* \.(?:php[0-9]*|phtml|phar)$ {
    return 404;
}

location / {
    try_files $uri $uri/ /{{ site.php_front_controller }}$is_args$args;
}
{% elif site.proxy is defined %}

location / {
    proxy_pass {{ site.proxy }};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header X-Real-IP $remote_addr;
{% if inner %}
    # The front key (here when Varnish was skipped: the backup, the WAF's
    # fallback) never reaches the app.
    proxy_set_header X-Noix-Front "";
    # The public block's, unchanged.
    proxy_set_header X-Forwarded-For $http_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-Host $http_x_forwarded_host;
    proxy_set_header X-Forwarded-Port $http_x_forwarded_port;
{% else %}
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
{% endif %}
}
{% else %}

location / {
    try_files $uri $uri/ =404;
}
{% endif %}
{% endmacro %}
# managed by noixdev.infra (nginx role): site {{ site.name }}. Changes here are overwritten.
{% if site.tls != 'off' %}
# HTTP: ACME challenges, and a 301 to HTTPS.
server {
    {{ listen(80, false) | trim | indent(4) }}
    server_name {{ site.domains | join(' ') }};
    {{ logs() | trim | indent(4) }}
    {{ acme() | trim | indent(4) }}
    location / {
        return 301 https://$host$request_uri;
    }
}

{% endif %}
{% if site.redirect_domains | length > 0 %}
# The redirect domains: a 301 to {{ scheme }}://{{ canonical }}.
{% for port in ([80] + ([443] if https else [])) %}
server {
    {{ listen(port, port == 443) | trim | indent(4) }}
    server_name {{ site.redirect_domains | join(' ') }};
    {{ logs() | trim | indent(4) }}
{% if port == 80 and site.tls != 'off' %}
    {{ acme() | trim | indent(4) }}
{% endif %}
    location / {
        return 301 {{ scheme }}://{{ canonical }}$request_uri;
    }
}

{% endfor %}
{% endif %}
{% if site.tls == 'off' or https %}
server {
    {{ listen(443 if https else 80, https) | trim | indent(4) }}
    server_name {{ site.domains | join(' ') }};
    {{ logs() | trim | indent(4) }}
    client_max_body_size {{ site.client_max_body_size }};
{% if site.root is defined and not site.front %}
    {{ root(site) | trim | indent(4) }}
{% endif %}
{% if site.rate_limit is defined %}
{% set zone = nginx_rate_limit_zones | selectattr('name', 'eq', site.rate_limit) | first %}
    limit_req zone={{ zone.name }} burst={{ zone.burst | default(0) }} nodelay;
{% endif %}
{% if site.basic_auth_on %}
    # Basic auth. Only this server block has it: the ACME challenges are
    # answered by the port 80 blocks above.
    auth_basic "Restricted";
    auth_basic_user_file {{ nginx_htpasswd_dir }}/{{ site.name }};
{% if site.basic_auth_allow | length > 0 %}
    satisfy any;
{% for address in site.basic_auth_allow %}
    allow {{ address }};
{% endfor %}
    deny all;
{% endif %}
{% endif %}
{% for header in ns.headers %}
    add_header {{ header[0] }} "{{ header[1] | replace('\\', '\\\\') | replace('"', '\\"') }}" always;
{% endfor %}
{% if site.hardening %}

    include {{ nginx_role_dir }}/hardening.conf;
{% endif %}
{% if site.front %}
{% if site.varnish %}

    # Invalidation goes to Varnish from the host, never through here.
    if ($request_method ~ ^(PURGE|BAN)$) {
        return 405;
    }
{% endif %}
{% if nginx_error_pages %}

    {{ error_pages(site, false) | trim | indent(4) }}
{% endif %}
{% if site.anubis %}

    {{ anubis() | trim | indent(4) }}
{% endif %}
{% if site.extra | length > 0 %}

    # extra (before the front hop: a location here is not sent there)
    {{ site.extra | indent(4) }}
{% endif %}

{% if site.varnish and not site.waf %}
    # The front hop (Varnish, {{ site.front }}): every request the checks
    # above let through, its body and answer streamed. Its answers pass
    # unchanged; while it does not answer, the inner block answers, uncached
    # (the upstream {{ nginx_varnish_upstream }}).
    location / {
        proxy_pass http://{{ nginx_varnish_upstream }};
        proxy_next_upstream error timeout;
        # Longer than Varnish waits for the app: Varnish answers first (its
        # 503, or a stale page), never a second try at the inner block.
        proxy_read_timeout {{ nginx_varnish_read_timeout }}s;
{% else %}
    # The front hop ({{ site.front }}): every request the checks above let
    # through, its body and answer streamed. Its answers, the WAF's own 403 too, pass
    # unchanged; while it does not answer, nginx answers 502.
    location / {
        proxy_pass {{ site.front }};
{% endif %}
        proxy_http_version 1.1;
        proxy_request_buffering off;
        # The inner block buffers unless the app says X-Accel-Buffering: no
        # (which it keeps to itself): streamed answers stay streamed.
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
{% if site.varnish %}
        # For Varnish (through the WAF with waf): the site's name and the
        # host's front key, both in place of the client's. Its cache status
        # goes to the access log, not to the client.
        proxy_set_header X-Noix-Site {{ site.name }};
        include {{ nginx_varnish_front_conf }};
        proxy_hide_header X-Noix-Cache;
{% endif %}
    }
{% else %}

    {{ content(site, false) | trim | indent(4) }}
{% endif %}
}
{% if site.front %}

# The inner block: the content, for the front hop only (on the loopback,
# where the WAF sends what it lets through, and Varnish what it does not
# have). The public block above did the TLS, rate limit, Basic auth,
# hardening, headers and Anubis, and logged the request.
server {
    listen 127.0.0.1:{{ nginx_inner_port }};
    server_name {{ site.domains | join(' ') }};
    access_log off;
    error_log /var/log/nginx/{{ site.name }}.error.log;
    client_max_body_size {{ site.client_max_body_size }};
    # nginx's own redirects (a directory without its /) name no host and no
    # port, so never this listener.
    absolute_redirect off;
    # The client's address: the last one in X-Forwarded-For that the hops on
    # the loopback did not add.
    set_real_ip_from 127.0.0.1;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    # The front key (here when Varnish was skipped: the backup, the WAF's
    # fallback) never reaches an app: for every location without its own
    # proxy_set_header or fastcgi_param (an inner_extra location with its
    # own clears X-Noix-Front itself).
    proxy_set_header X-Noix-Front "";
    fastcgi_param HTTP_X_NOIX_FRONT "";
{% if site.root is defined %}
    {{ root(site) | trim | indent(4) }}
{% endif %}

    # The nginx role's probe through the WAF (tasks/main.yml), never the
    # app's.
    location = {{ nginx_waf_probe_path }} {
        return 204;
    }

    {{ content(site, true) | trim | indent(4) }}
}
{% endif %}
{% endif %}
