# managed by noixdev.infra (nginx role). Changes here are overwritten.
# Unknown host names: the connection closes on 80 (444), and the TLS
# handshake is rejected on 443. No site is served for a name it does not list.
server {
    listen 80 default_server;
{% if nginx_ipv6 %}
    listen [::]:80 default_server;
{% endif %}
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
{% if nginx_ipv6 %}
    listen [::]:443 ssl default_server;
{% endif %}
    server_name _;
    ssl_reject_handshake on;
}
{% if nginx_waf_sites | length > 0 %}

# The inner listener of the waf sites: a Host none of them lists (a waf_sites
# entry no nginx site matches) gets no site's content. The role's probe
# through the WAF gets its 204 here while its site has no inner block yet.
server {
    listen 127.0.0.1:{{ nginx_inner_port }} default_server;
    server_name _;
    location = {{ nginx_waf_probe_path }} {
        return 204;
    }
    location / {
        return 421;
    }
}
{% endif %}
