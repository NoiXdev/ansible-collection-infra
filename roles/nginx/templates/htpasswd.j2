{#
  The Basic auth users of one site (nginx_site: the site from
  nginx_sites_public; the users come from nginx_sites, which holds the
  passwords). SHA-512 crypt, which nginx reads through crypt(). The salt comes
  from the site and the user name, never from the password: a rerun writes the
  same hash, and a changed password changes it. 5000 rounds are crypt's own
  default: nginx hashes the password of every request it checks.
  Only a no_log task renders this.
#}
{% set users = (nginx_sites | selectattr('name', 'eq', nginx_site.name) | first).basic_auth.users %}
# managed by noixdev.infra (nginx role): the Basic auth users of site {{ nginx_site.name }}.
{% for user in users %}
{{ user.name }}:{{ user.password | password_hash('sha512', (nginx_site.name ~ ':' ~ user.name) | hash('sha256') | truncate(16, true, ''), rounds=5000) }}
{% endfor %}
