# managed by noixdev.infra (nginx role). Changes here are overwritten.
user www-data;
worker_processes auto;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log notice;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';
{% if nginx_varnish_sites | length > 0 %}
    # The sites with varnish: main and the cache status Varnish answered
    # (HIT, MISS, PASS, SYNTH, with +grace for a stale page; - when Varnish
    # did not answer).
    log_format varnish '$remote_addr - $remote_user [$time_local] "$request" '
                       '$status $body_bytes_sent "$http_referer" '
                       '"$http_user_agent" "$http_x_forwarded_for" '
                       'cache=$upstream_http_x_noix_cache';
{% endif %}
    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    server_tokens off;

    # Mozilla "intermediate" (guidelines 6.0).
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers {{ nginx_tls_ciphers }};
    ssl_ecdh_curve {{ nginx_tls_curves }};
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:noixdev:10m;
    ssl_session_tickets off;

    # The Connection header towards a proxy site: upgrade for WebSockets.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }
{% if nginx_varnish_sites | length > 0 %}

    # The varnish sites without waf: Varnish, and while it does not answer
    # (refused or timed out, never on a status it answers) the inner
    # listener, uncached. A Varnish that did not answer is tried again after
    # 5 s.
    upstream {{ nginx_varnish_upstream }} {
        server 127.0.0.1:{{ nginx_varnish_port }} max_fails=1 fail_timeout=5s;
        server 127.0.0.1:{{ nginx_inner_port }} backup;
    }
{% endif %}

{% for zone in nginx_rate_limit_zones %}
    limit_req_zone $binary_remote_addr zone={{ zone.name }}:10m rate={{ zone.rate }};
{% endfor %}
    limit_req_status 429;
{% if nginx_real_ip_from | length > 0 %}

    # Proxies whose X-Forwarded-For is trusted.
{% for address in nginx_real_ip_from %}
    set_real_ip_from {{ address }};
{% endfor %}
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
{% endif %}
{% if nginx_http_extra | length > 0 %}

    # nginx_http_extra
    {{ nginx_http_extra | indent(4) }}
{% endif %}

    include /etc/nginx/conf.d/*.conf;
    # One file per site, in sorted order.
    include {{ nginx_sites_dir }}/*.conf;
}
