# Managed by Ansible (role noixdev.infra.harbor); do not edit.
# Rendered on every run; prepare reads it. Traefik terminates TLS, so there is
# no https block and Harbor's nginx speaks plain HTTP.
hostname: {{ harbor_hostname }}
external_url: {{ harbor_external_url | to_json }}

http:
  # Container port 8080; the compose override removes the host port.
  port: 80

harbor_admin_password: {{ harbor_admin_password | to_json }}

database:
  password: {{ harbor_db_password | to_json }}
  max_idle_conns: 100
  max_open_conns: 900
  conn_max_lifetime: 5m
  conn_max_idle_time: 0

# prepare reads this line with grep and awk: keep it unquoted.
data_volume: {{ harbor_data_dir }}

{% if harbor_storage == 's3' %}
storage_service:
  s3:
{% if harbor_s3.endpoint | default('') %}
    regionendpoint: {{ harbor_s3.endpoint | to_json }}
{% endif %}
    region: {{ harbor_s3.region | to_json }}
    bucket: {{ harbor_s3.bucket | to_json }}
    accesskey: {{ harbor_s3.access_key | to_json }}
    secretkey: {{ harbor_s3.secret_key | to_json }}
    secure: {{ harbor_s3.secure | default(true) | bool | to_json }}
    v4auth: {{ harbor_s3.v4auth | default(true) | bool | to_json }}
    chunksize: {{ harbor_s3.chunksize | default(5242880) | int }}
    rootdirectory: {{ harbor_s3.rootdirectory | default('/') | to_json }}
{% endif %}

trivy:
  ignore_unfixed: false
  skip_update: false
  skip_java_db_update: false
  offline_scan: false
  security_check: vuln
  insecure: false
  timeout: 5m0s

jobservice:
  max_job_workers: 10
  max_job_duration_hours: 24
  job_loggers:
    - STD_OUTPUT
    - FILE
  logger_sweeper_duration: 1

notification:
  webhook_job_max_retry: 3
  webhook_job_http_client_timeout: 3

log:
  level: {{ harbor_log_level }}
  local:
    rotate_count: 50
    rotate_size: 200M
    location: {{ harbor_log_dir }}

# Configuration format of this installer, read from its harbor.yml.tmpl.
_version: {{ harbor_config_version }}

proxy:
  http_proxy:
  https_proxy:
  no_proxy:
  components:
    - core
    - jobservice
    - trivy

upload_purging:
  enabled: true
  age: 168h
  interval: 24h
  dryrun: false

cache:
  enabled: false
  expire_hours: 24
