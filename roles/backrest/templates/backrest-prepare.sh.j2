#!/bin/sh
# Managed by Ansible. Run by Backrest before each snapshot. Dumps the apps and
# checks their paths. What fails is left out of this snapshot through the
# exclude file and recorded in the failures file; the other apps are still
# backed up, and backrest-finish marks the backup as failed afterwards. Exits
# non-zero only when it cannot do its own work, which stops the snapshot.
# The paths below are quoted on purpose; a path may hold $ and \ characters.
# shellcheck disable=SC2016
umask 077
excludes={{ backrest_excludes_file | quote }}
failures={{ backrest_failures_file | quote }}
active_apps={{ backrest_active_apps_file | quote }}
dump_timeout={{ backrest_dump_timeout | int }}

die() {
  echo "backrest-prepare: $*" >&2
  exit 1
}

# empty_file <file>: replaces the file by an empty one, never writing into a directory.
empty_file() {
  : >"$1.new" || die "cannot write $1.new"
  if [ -d "$1" ] || ! mv -f "$1.new" "$1"; then
    rm -f "$1.new"
    die "cannot replace $1"
  fi
}

# fail_app <reason>: records a failure of the current app.
fail_app() {
  printf '%s: %s\n' "$app" "$1" >>"$failures" || die "cannot write $failures"
  echo "backrest-prepare: $app: $1" >&2
}

# exclude <path>: leaves exactly this path out of the snapshot. restic reads the
# file as patterns after expanding environment variables, so * ? [ and \ are
# escaped, and $ becomes [$], which no expansion touches.
exclude() {
  printf '%s\n' "$1" | sed -e 's/[\\*?[]/\\&/g' -e 's/\$/[$]/g' >>"$excludes" || die "cannot write $excludes"
}

is_active() {
  grep -qxF -- "$app" "$active_apps" 2>/dev/null
}

# check_path <path>: it must exist and not be empty (an unmounted volume is empty).
check_path() {
  if [ -d "$1" ]; then
    [ -z "$(ls -A -- "$1" 2>/dev/null)" ] || return 0
  elif [ -s "$1" ]; then
    return 0
  fi
  fail_app "$1 is missing or empty"
  exclude "$1"
}

# dump_failed <output> <reason>: the old output stays on disk but out of the snapshot.
dump_failed() {
  fail_app "$2"
  exclude "$1"
}

# dump_postgres <project> <service> <user> <database> <output>
dump_postgres() {
  tmp="$5.tmp"
  rm -f "$tmp"
  ids=$(docker ps -q --filter "label=com.docker.compose.project=$1" --filter "label=com.docker.compose.service=$2") \
    || { dump_failed "$5" "docker ps failed"; return 0; }
  count=$(printf '%s\n' "$ids" | grep -c .)
  if [ "$count" != 1 ]; then
    dump_failed "$5" "found $count containers running for compose project $1, service $2; expected 1"
    return 0
  fi
  if timeout "$dump_timeout" docker exec "$ids" pg_dump -Fc -U "$3" "$4" >"$tmp" \
    && timeout "$dump_timeout" docker exec -i "$ids" pg_restore --list <"$tmp" >/dev/null \
    && mv -f "$tmp" "$5"; then
    return 0
  fi
  rm -f "$tmp"
  dump_failed "$5" "the dump of database $4 failed, was not readable or took longer than $dump_timeout seconds"
}

# dump_command <command> <output>
dump_command() {
  if ! timeout "$dump_timeout" "$1" </dev/null; then
    dump_failed "$2" "$1 failed or took longer than $dump_timeout seconds"
  elif [ ! -e "$2" ]; then
    dump_failed "$2" "$1 left no $2"
  fi
}

empty_file "$excludes"
empty_file "$failures"
{% for app in backrest_apps %}

app={{ app.name | quote }}
{% if app.requires_path is defined %}
if [ -e {{ app.requires_path | quote }} ]; then installed=yes; else installed=no; fi
{% else %}
installed=yes
{% endif %}
if [ "$installed" = no ]; then
  echo "backrest-prepare: $app: not installed, skipped" >&2
elif ! is_active; then
  fail_app "is installed but not in the backup plan yet; run the playbook"
else
  :
{% for path in app.paths | default([]) %}
  check_path {{ path | quote }}
{% endfor %}
{% if app.dump is defined and app.dump.type == 'postgres' %}
  dump_postgres {{ app.dump.project | quote }} {{ app.dump.service | quote }} {{ app.dump.user | quote }} {{ app.dump.database | quote }} {{ (backrest_dump_dir ~ '/' ~ app.name ~ '.dump') | quote }}
{% elif app.dump is defined and app.dump.type == 'command' %}
  dump_command {{ app.dump.command | quote }} {{ app.dump.output | quote }}
{% endif %}
fi
{% endfor %}
exit 0
