# Managed by Ansible (noixdev.infra.pulsix_agent).
PULSIX_MANAGER_ADDR={{ pulsix_agent_manager_addr }}
{% if pulsix_agent_name | string | trim != '' %}
PULSIX_AGENT_NAME={{ pulsix_agent_name | string | trim }}
{% endif %}
{% if pulsix_agent_server_name | string | trim != '' %}
PULSIX_MANAGER_SERVER_NAME={{ pulsix_agent_server_name | string | trim }}
{% endif %}
{% if not pulsix_agent_identity.stat.exists %}
PULSIX_ENROLL_TOKEN={{ pulsix_agent_token }}
{% endif %}
