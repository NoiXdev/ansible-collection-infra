#!/bin/bash
# Managed by noixdev.infra (php role). Changes here are overwritten.
#
# php-fpm-rolling-restart VERSION
#   Restarts each running php-fpm@<name> whose /etc/php-fpm/<name>/env names
#   PHP VERSION, one at a time, in the order of their names. The restart may
#   take up to {{ php_fpm_restart_timeout }} seconds, and then the pool must answer its ping
#   (/php-fpm-ping: pong) within {{ php_fpm_restart_timeout }} seconds before the next one
#   restarts. One that does not stops the run (exit 1): the pools not restarted
#   yet keep running. Messages go to stderr and to the journal
#   (journalctl -t php-fpm-rolling-restart).
#
# --dpkg-pre-invoke, --dpkg-post-invoke
#   For the apt hook /etc/apt/apt.conf.d/99noixdev-php-fpm-restart: before a
#   dpkg run, remember where dpkg's log ends; after it, run the restart above
#   for each version with a php<v>-* package (fpm, cli, an extension) the run
#   upgraded or reinstalled, as the log names it. A failure is logged, never
#   passed on to apt (exit 0).
set -u

tag=php-fpm-rolling-restart
limit={{ php_fpm_restart_timeout }}
dpkg_log=/var/log/dpkg.log
# Under /run: a reboot restarts every pool anyway.
dpkg_log_mark=/run/php-fpm-rolling-restart.dpkg-log-offset

log() {
  echo "$tag: $*" >&2
  logger -t "$tag" -- "$*" 2>/dev/null || true
}

# answers NAME: the pool answers its ping on its socket.
answers() {
  SCRIPT_NAME=/php-fpm-ping SCRIPT_FILENAME=/php-fpm-ping REQUEST_METHOD=GET \
    timeout 2 cgi-fcgi -bind -connect "/run/php/$1.sock" 2>/dev/null | tr -d '\r' | grep -qx pong
}

# restart NAME: restart the pool, then wait for its ping. A restart that hangs
# must not hold up apt: systemd's own start timeout is 90 seconds.
restart() {
  local name="$1" deadline
  timeout "$limit" systemctl restart "php-fpm@$name" || return 1
  deadline=$((SECONDS + limit))
  until answers "$name"; do
    [ "$SECONDS" -lt "$deadline" ] || return 1
    sleep 1
  done
}

# rolling_restart VERSION
rolling_restart() {
  local version="$1" env name
  for env in /etc/php-fpm/*/env; do
    [ -f "$env" ] || continue
    grep -qxF "PHP_VERSION=$version" "$env" || continue
    name="$(basename "$(dirname "$env")")"
    systemctl is-active --quiet "php-fpm@$name" || continue
    log "restarting $name (PHP $version)"
    if ! restart "$name"; then
      log "$name did not come back; stopping"
      return 1
    fi
    log "$name answers (pid $(systemctl show -p MainPID --value "php-fpm@$name"))"
  done
}

# A mark left by a dpkg run whose Post-Invoke did not run stays, so the next
# run also covers that one.
dpkg_pre_invoke() {
  [ ! -e "$dpkg_log_mark" ] || return 0
  stat -c %s "$dpkg_log" >"$dpkg_log_mark" 2>/dev/null || echo 0 >"$dpkg_log_mark"
}

dpkg_post_invoke() {
  local mark size version
  [ -r "$dpkg_log_mark" ] || return 0
  mark="$(cat "$dpkg_log_mark")"
  rm -f "$dpkg_log_mark"
  case "$mark" in '' | *[!0-9]*) mark=0 ;; esac
  size="$(stat -c %s "$dpkg_log" 2>/dev/null)" || return 0
  # A log rotated in between starts again.
  [ "$size" -ge "$mark" ] || mark=0
  # "<date> <time> upgrade php8.3-intl:<arch> <old> <new>", also for a
  # reinstall of the same version. The role's pin keeps php<v>-* to the PPA.
  for version in $(tail -c +"$((mark + 1))" "$dpkg_log" \
      | sed -n -E 's/^[^ ]+ [^ ]+ upgrade php([0-9]+[.][0-9]+)-[^: ]+:[^ ]+ .*$/\1/p' | sort -u -V); do
    log "PHP $version packages were upgraded: restarting the pools one at a time"
    rolling_restart "$version" \
      || log "PHP $version: the rolling restart stopped; the pools not restarted yet keep running"
  done
}

case "${1:-}" in
  --dpkg-pre-invoke) dpkg_pre_invoke; exit 0 ;;
  --dpkg-post-invoke) dpkg_post_invoke; exit 0 ;;
esac

if [ "$#" -ne 1 ] || ! [[ "$1" =~ ^[0-9]+[.][0-9]+$ ]]; then
  echo "usage: $tag VERSION (such as 8.3)" >&2
  exit 2
fi
rolling_restart "$1"
