; Managed by noixdev.infra (php role). Changes here are overwritten.
{% import 'ini.j2' as ini %}
{% set pm = php_pm_defaults | combine(item.pm | default({})) %}
{% set tmp_dir = item.tmp_dir | default('') | regex_replace('/+$', '') %}
{% set open_basedir = item.open_basedir | default([]) + ([tmp_dir] if tmp_dir and item.open_basedir | default([]) | length > 0 else []) %}
[{{ item.name }}]
user = {{ item.user }}
group = {{ php_pool_groups[item.name] }}
listen = /run/php/{{ item.name }}.sock
listen.owner = {{ item.user }}
listen.group = {{ php_fpm_listen_group }}
listen.mode = 0660

pm = {{ pm.mode }}
pm.max_children = {{ pm.max_children }}
{% if pm.mode == 'dynamic' %}
pm.start_servers = {{ pm.start_servers }}
pm.min_spare_servers = {{ pm.min_spare_servers }}
pm.max_spare_servers = {{ pm.max_spare_servers }}
{% endif %}
pm.status_path = /php-fpm-status
ping.path = /php-fpm-ping
ping.response = pong

php_admin_flag[log_errors] = On
php_admin_value[error_log] = {{ ini.quoted('/var/log/php/' ~ item.name ~ '.log') }}
{% if open_basedir | length > 0 %}
php_admin_value[open_basedir] = {{ ini.quoted(open_basedir | join(':')) }}
{% endif %}
{% if tmp_dir %}
php_admin_value[session.save_path] = {{ ini.quoted(tmp_dir ~ '/session') }}
php_admin_value[upload_tmp_dir] = {{ ini.quoted(tmp_dir ~ '/upload') }}
php_admin_value[sys_temp_dir] = {{ ini.quoted(tmp_dir ~ '/sys') }}
{% endif %}
{% for key, value in item.ini | default({}) | dictsort %}
php_admin_value[{{ key }}] = {{ ini.setting(value) }}
{% endfor %}
{% for key, value in item.env | default({}) | dictsort %}
env[{{ key }}] = {{ ini.quoted(value) }}
{% endfor %}
