# Managed by noixdev.infra (php role). Changes here are overwritten.
# One PHP-FPM master per pool: /etc/php-fpm/%i/php-fpm.conf, run by the
# php-fpm of the version in /etc/php-fpm/%i/env. The hardening is the
# packages' own php-fpm unit's.
[Unit]
Description=PHP-FPM pool %i
Documentation=man:php-fpm(8)
After=network.target

[Service]
Type=notify
EnvironmentFile=/etc/php-fpm/%i/env
# systemd takes no variable in the program path; env runs php-fpm in its place.
ExecStart=/usr/bin/env /usr/sbin/php-fpm${PHP_VERSION} --nodaemonize --fpm-config /etc/php-fpm/%i/php-fpm.conf
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
# The pid files of all pools; it stays while one of them stops.
RuntimeDirectory=php-fpm
RuntimeDirectoryPreserve=yes
ProtectSystem=full
PrivateDevices=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=true

[Install]
WantedBy=multi-user.target
