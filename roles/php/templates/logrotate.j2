# Managed by noixdev.infra (php role). Changes here are overwritten.
# PHP opens a pool's log per message, so the new file needs no signal.
{% for pool in php_pools_public %}
/var/log/php/{{ pool.name }}.log {
    weekly
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    create 0640 {{ pool.user }} {{ php_pool_groups[pool.name] }}
}
{% endfor %}
