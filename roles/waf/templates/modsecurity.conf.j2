# {{ ansible_managed }}
# ModSecurity for every site of the WAF, loaded once (nginx's http level), in
# this order: the engine settings, the role's own rules, waf_rules_before,
# the sites' Host-keyed rules and the role's rules that use them, the Core
# Rule Set, the credentials kept out of it, waf_rules_after. Each site's
# server block (nginx.conf) sets the engine mode, so it follows nginx's own
# choice of server block.

# The engine. In mode block nginx answers 413 to a body over the site's
# inspection limit before ModSecurity reads it (the site's
# client_max_body_size); Reject is only the backstop and answers 403.
# DetectionOnly always passes such a body, inspecting up to the limit.
SecRuleEngine On
SecRequestBodyAccess On
SecRequestBodyLimit {{ waf_request_body_limit }}
SecRequestBodyLimitAction Reject
SecRequestBodyJsonDepthLimit 512
SecArgumentsLimit {{ waf_arguments_limit }}
SecPcreMatchLimit 100000
SecPcreMatchLimitRecursion 100000
SecResponseBodyAccess Off
SecTmpDir {{ waf_spool_mount }}
SecDataDir /tmp
SecArgumentSeparator &
SecCookieFormat 0
SecUnicodeMapFile {{ waf_unicode_map }} 20127
SecStatusEngine Off

# The audit log: one JSON line per event on the container's stdout (docker
# logs), with the client address, the request line, the status and the
# matched rules, never request headers or bodies (parts A, H and Z), which
# would put credentials into the log. An event is a request that matched a
# logging rule or answered an error (not 404).
SecAuditEngine RelevantOnly
SecAuditLogRelevantStatus "{{ waf_audit_relevant_status }}"
SecAuditLogParts AHZ
SecAuditLogType Serial
SecAuditLogFormat JSON
SecAuditLog /dev/stdout

# The role's own rules (9599900-9599999): XML and JSON bodies are parsed into
# arguments, so the Core Rule Set inspects their values (it picks the JSON
# parser itself only for +json and AWS JSON types, not application/json);
# a body that cannot be parsed is refused rather than passed uninspected. An
# empty body (a POST or DELETE without one, but with the content type) has
# nothing to inspect and passes: the XML parser reports an error for it.
SecRule REQUEST_HEADERS:Content-Type "@rx ^(?:application(?:/soap\+|/)|text/)xml" "id:9599900,phase:1,t:none,t:lowercase,pass,nolog,ctl:requestBodyProcessor=XML"
SecRule REQUEST_HEADERS:Content-Type "@rx ^application/json" "id:9599902,phase:1,t:none,t:lowercase,pass,nolog,ctl:requestBodyProcessor=JSON"
SecRule REQBODY_ERROR "!@eq 0" "id:9599901,phase:2,t:none,log,deny,status:400,severity:'CRITICAL',msg:'Failed to parse request body.',chain"
  SecRule REQUEST_BODY_LENGTH "!@eq 0" "t:none"
# The other body checks of ModSecurity's recommended configuration. Arguments
# past SecArgumentsLimit are never inspected (ModSecurity drops them), so a
# request with that many is refused: a thousand dummy arguments would
# otherwise carry an attack past every rule. A multipart body that its parser
# could not read strictly, or with a line that looks like another boundary,
# is refused (multipart parsers differ; the backend's might see other
# parts). An internal error of ModSecurity (such as a regex over
# SecPcreMatchLimit) means a rule could not finish: the request is refused.
SecRule &ARGS "@ge {{ waf_arguments_limit }}" "id:9599907,phase:2,t:none,log,deny,status:400,severity:'CRITICAL',msg:'Failed to fully parse request body due to large argument count'"
SecRule MULTIPART_STRICT_ERROR "!@eq 0" "id:9599908,phase:2,t:none,log,deny,status:400,severity:'CRITICAL',msg:'Multipart request body failed strict validation: PE %{REQBODY_PROCESSOR_ERROR}, BQ %{MULTIPART_BOUNDARY_QUOTED}, BW %{MULTIPART_BOUNDARY_WHITESPACE}, DB %{MULTIPART_DATA_BEFORE}, DA %{MULTIPART_DATA_AFTER}, HF %{MULTIPART_HEADER_FOLDING}, LF %{MULTIPART_LF_LINE}, SM %{MULTIPART_MISSING_SEMICOLON}, IQ %{MULTIPART_INVALID_QUOTING}, IP %{MULTIPART_INVALID_PART}, IH %{MULTIPART_INVALID_HEADER_FOLDING}, FL %{MULTIPART_FILE_LIMIT_EXCEEDED}'"
SecRule MULTIPART_UNMATCHED_BOUNDARY "@eq 1" "id:9599909,phase:2,t:none,log,deny,severity:'CRITICAL',msg:'Multipart parser detected a possible unmatched boundary.'"
SecRule TX:/^MSC_/ "!@streq 0" "id:9599910,phase:2,t:none,log,deny,severity:'CRITICAL',msg:'ModSecurity internal error flagged: %{MATCHED_VAR_NAME}'"
{% if waf_rules_before | length > 0 %}

# waf_rules_before
{{ waf_rules_before }}
{% endif %}

# The sites' settings, keyed by the Host header the proxy in front routed by
# (lower-cased, with or without a port), before the Core Rule Set reads them,
# and the site's name and inspection limit for the role's rules below.
{% for site in waf_sites_public %}
# Site {{ site.name }}
SecRule REQUEST_HEADERS:Host "@rx {{ site.host_regex }}" "id:{{ 9500000 + 100 * site.index }},phase:1,pass,nolog,t:none,t:lowercase,setvar:tx.noix_waf_site={{ site.name }},setvar:tx.noix_waf_mode={{ site.mode }},setvar:tx.noix_waf_body_limit={{ site.request_body_limit }},setvar:tx.blocking_paranoia_level={{ site.paranoia }},setvar:tx.detection_paranoia_level={{ site.detection_paranoia }},setvar:tx.inbound_anomaly_score_threshold={{ site.anomaly_inbound }},setvar:tx.outbound_anomaly_score_threshold={{ site.anomaly_outbound }}
{%- if site.allowed_methods | length > 0 -%}
,setvar:'tx.allowed_methods={{ (waf_crs_methods + site.allowed_methods) | unique | join(' ') }}'
{%- endif -%}
{%- if site.allowed_content_types | length > 0 -%}
,setvar:'tx.allowed_request_content_type=
{%- for type in (waf_crs_content_types + site.allowed_content_types) | unique -%}
|{{ type }}|{{ '' if loop.last else ' ' }}
{%- endfor -%}
'
{%- endif -%}
"
{% endfor %}

# A body over the site's inspection limit, as an event of its own: mode
# block answers 413 to it, so noix-waf-report shows which detect sites would.
# On a detect site such a body, and a chunked one, then passes without
# ModSecurity's body checks (nginx.conf: ModSecurity would read it whole
# into memory), after these phase 1 rules logged it.
SecRule TX:noix_waf_body_limit "@gt 0" "id:9599903,phase:1,pass,t:none,log,severity:'NOTICE',msg:'Request body over the inspection limit, not inspected (mode block answers 413)',logdata:'Content-Length %{MATCHED_VAR}, limit %{tx.noix_waf_body_limit}',tag:'noix-waf/body-limit',chain"
  SecRule REQUEST_HEADERS:Content-Length "@gt %{tx.noix_waf_body_limit}" "t:none"
SecRule TX:noix_waf_mode "@streq detect" "id:9599911,phase:1,pass,t:none,log,severity:'NOTICE',msg:'Chunked request body, not inspected in mode detect (mode block inspects it)',tag:'noix-waf/chunked',chain"
  SecRule &REQUEST_HEADERS:Transfer-Encoding "@gt 0" "t:none"
# Every event names its site: when the audit log writes the request (an
# error status, or a matched rule with a severity, which every logging rule
# of the Core Rule Set has), one more message carries the site's name. Other
# requests get no such message, which would make each of them an event.
SecRule RESPONSE_STATUS "@rx {{ waf_audit_relevant_status }}" "id:9599904,phase:5,pass,nolog,t:none,setvar:tx.noix_waf_event=1"
SecRule HIGHEST_SEVERITY "@lt 255" "id:9599905,phase:5,pass,nolog,t:none,setvar:tx.noix_waf_event=1"
SecRule TX:noix_waf_event "@eq 1" "id:{{ waf_site_rule_id }},phase:5,pass,t:none,log,msg:'Site',logdata:'%{tx.noix_waf_site}',tag:'noix-waf/site',chain"
  SecRule TX:noix_waf_site "@rx ." "t:none"

# The Core Rule Set of the image.
Include {{ waf_crs_dir }}/crs-setup.conf
Include {{ waf_crs_dir }}/rules/*.conf

# Credentials are never inspected: a matching rule would copy the value into
# the log (ModSecurity cannot mask it). Request headers and cookies whose
# names contain one of waf_secret_names (in any case), such as
# Authorization, Cookie, X-Api-Key and session cookies, are left out of every
# rule; their names are still inspected.
{% for collection in ['REQUEST_HEADERS', 'REQUEST_COOKIES'] %}
SecRuleUpdateTargetByTag OWASP_CRS "{% for name in waf_secret_names %}!{{ collection }}:/{{ name }}/{{ '' if loop.last else '|' }}{% endfor %}"
{% endfor %}
{% if waf_rules_after | length > 0 %}

# waf_rules_after
{{ waf_rules_after }}
{% endif %}
