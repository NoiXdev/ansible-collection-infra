{#- The ModSecurity rules of a server block or location, one
    modsecurity_rules directive per rule (each a single-quoted nginx string;
    the checks keep quotes out of tags, IDs and targets). -#}
{%- macro rules(lines, indent) -%}
{%- set directives = [] -%}
{%- for line in lines %}{% set _ = directives.append(indent ~ "modsecurity_rules '" ~ line ~ "';") %}{% endfor -%}
{{ directives | join(waf_newline) }}
{%- endmacro -%}
{%- macro exclusion_rules(exclusion) -%}
{%- set lines = [] -%}
{%- for tag in exclusion.remove_tags %}{% set _ = lines.append('SecRuleRemoveByTag ' ~ tag) %}{% endfor -%}
{%- for id in exclusion.remove_ids %}{% set _ = lines.append('SecRuleRemoveById ' ~ id) %}{% endfor -%}
{%- for target in exclusion.remove_targets %}{% set _ = lines.append('SecRuleUpdateTargetById ' ~ target.id ~ ' "!' ~ target.target ~ '"') %}{% endfor -%}
{{ lines | to_json }}
{%- endmacro -%}
{#- A regex for a Content-Length above limit (digits): more digits, or as
    many and a higher one at the first place they differ; leading zeros
    allowed. -#}
{%- macro over_limit_re(limit) -%}
{%- set n = limit | string -%}
{%- set alternatives = ['[1-9][0-9]{' ~ n | length ~ ',}'] -%}
{%- for i in range(n | length) if n[i] | int < 9 -%}
{%- set rest = n | length - i - 1 -%}
{%- set _ = alternatives.append(n[:i] ~ '[' ~ (n[i] | int + 1) ~ '-9]' ~ (('[0-9]{' ~ rest ~ '}') if rest > 0 else '')) -%}
{%- endfor -%}
^0*({{ alternatives | join('|') }})$
{%- endmacro -%}
{#- The refusals of a bypass or exclusion location: nginx matched its prefix
    on the normalized path, but the backend gets the raw one. -#}
{%- macro raw_path_checks(path, indent) -%}
{{ indent }}# The backend gets the raw path: it must start with the prefix itself
{{ indent }}# and have no .. segment, so no crafted path (/a/%2e%2e{{ path }}) gets
{{ indent }}# this location's settings for another path.
{{ indent }}if ($request_uri !~ "^{{ path | regex_escape }}") {
{{ indent }}  return 400;
{{ indent }}}
{{ indent }}if ($request_uri ~* "{{ waf_raw_dots_re }}") {
{{ indent }}  return 400;
{{ indent }}}
{%- endmacro -%}
{#- On a detect site, the request bodies ModSecurity does not get: it reads
    a body whole into memory, so one larger than the site's inspection limit
    (by its Content-Length) and a chunked one (of a length nginx cannot know
    first) go to @waf_uninspected. Only the phase 1 rules have run by then
    (the rule set's URI and argument rules are phase 2, so they do not run
    at all); they log such a body (role rules 9599903 and 9599911). Mode
    block answers 413 to a body over the limit instead
    (client_max_body_size). -#}
{%- macro uninspected_checks(site, indent) -%}
{{ indent }}if ($http_transfer_encoding) {
{{ indent }}  return 418;
{{ indent }}}
{{ indent }}if ($http_content_length ~ "{{ over_limit_re(site.request_body_limit) }}") {
{{ indent }}  return 418;
{{ indent }}}
{%- endmacro -%}
{#- host:port of a backend URL, the port from its scheme when it names none. -#}
{%- macro address(url) -%}
{{ url | regex_replace(waf_url_re, waf_url_host) }}:{{ url | regex_replace(waf_url_re, waf_url_port) or (443 if url is match('^https:') else 80) }}
{%- endmacro -%}
# {{ ansible_managed }}
# The WAF: one server block per site of waf_sites, picked by Host, which
# sends the site to its backend after ModSecurity's checks with the Core Rule
# Set (modsecurity.conf, loaded once for all sites). Paths are matched on the
# normalized path, so /v2/../x never gets the bypass or exclusion of /v2/,
# and a bypass or exclusion refuses a raw path that only its normalized form
# puts under the prefix (/a/%2e%2e/v2/x).
load_module {{ waf_module }};
worker_processes {{ waf_workers }};
pid /tmp/nginx.pid;
error_log /dev/stderr notice;

events {
  worker_connections 1024;
}

http {
  access_log off;
  server_tokens off;
  # What a site accepts at all stays with the proxy in front and the app;
  # ModSecurity inspects up to the site's request_body_limit. Only a site in
  # mode block sets a limit (its server block).
  client_max_body_size 0;
  # The root file system is read-only. Request bodies are spooled to disk
  # (waf_spool_dir); /tmp is the container's small tmpfs.
  client_body_temp_path {{ waf_spool_mount }}/client_body;
  proxy_temp_path /tmp/proxy;
  fastcgi_temp_path /tmp/fastcgi;
  uwsgi_temp_path /tmp/uwsgi;
  scgi_temp_path /tmp/scgi;

  # The client's address for ModSecurity, from the X-Forwarded-For of the
  # proxy in front only; nobody else can choose it.
  set_real_ip_from {{ waf_real_ip_from }};
  real_ip_header X-Forwarded-For;
{% if waf_mode == 'host' %}
  real_ip_recursive on;
{% else %}

  # Backend names are looked up per request: a recreated backend's new
  # address is used without a reload.
  resolver {{ waf_resolver }} valid={{ waf_resolver_valid }} ipv6=off;
  resolver_timeout 5s;
{% endif %}

  map $http_upgrade $waf_connection {
    default upgrade;
    '' close;
  }

  # Host, the X-Forwarded-* headers of the proxy in front and the rest of
  # the request pass unchanged; WebSocket upgrades pass; long uploads and
  # streams are not cut off after a minute.
  proxy_http_version 1.1;
  proxy_set_header Host $http_host;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $waf_connection;
  proxy_redirect off;
  proxy_buffering off;
  proxy_request_buffering off;
  proxy_read_timeout {{ waf_proxy_timeout }};
  proxy_send_timeout {{ waf_proxy_timeout }};
  proxy_ssl_server_name on;

  modsecurity on;
  modsecurity_rules_file {{ waf_conf_dir }}/modsecurity.conf;
{% for site in waf_sites_public if site.backend_fallback %}

  # Site {{ site.name }}: the fallback answers only while the backend does
  # not (refused or timed out, never on a status it answers). A backend that
  # did not answer is tried again after waf_fallback_retry (one error line
  # per worker that often while it is down, not one per request).
  upstream waf_{{ site.name }} {
    server {{ address(site.backend) }} max_fails=1 fail_timeout={{ waf_fallback_retry }};
    server {{ address(site.backend_fallback) }} backup;
  }
{% endfor %}

  # A Host no site lists. The header tells this 421 from a backend's (the
  # nginx role's probe in host mode refuses a site only on this one).
  server {
    listen {{ waf_listen }} default_server;
    modsecurity off;
    add_header {{ waf_unknown_header }} {{ waf_unknown_value }} always;
    return 421;
  }

  # The container's health check.
  server {
    listen 127.0.0.1:{{ waf_health_port }};
    modsecurity off;
    location = /healthz {
      default_type text/plain;
      return 200 "{{ waf_config_id }}\n";
    }
    location / {
      return 404;
    }
  }
{% for site in waf_sites_public %}
{% set root_exclusion = site.exclusions | selectattr('path', 'equalto', '/') | list %}

  # Site {{ site.name }} (mode {{ site.mode }}).
  server {
    listen {{ waf_listen }};
    server_name {{ site.domains | join(' ') }};
    # An absolute-form request line (http://other.test/) picks its server
    # block by its own host, while the site's settings follow Host.
    if ($request !~ "^[^ ]+ /") {
      return 400;
    }
{% if site.backend_fallback %}
    set $waf_backend "{{ site.backend.split(':')[0] }}://waf_{{ site.name }}";
    proxy_next_upstream error timeout;
    proxy_next_upstream_tries 2;
{% else %}
    set $waf_backend "{{ site.backend }}";
{% endif %}
{% if site.mode == 'block' %}
    # A body larger than ModSecurity inspects answers 413 (with a length or
    # chunked alike), so nothing passes uninspected. Exclusions keep it.
    client_max_body_size {{ site.request_body_limit }};
{% endif %}
{% if site.mode == 'off' %}
    modsecurity off;
{% else %}
    # The engine mode, the inspection limit and exclusions for the whole site.
{{ rules(['SecRuleEngine ' ~ ('On' if site.mode == 'block' else 'DetectionOnly')]
           + (['SecRequestBodyLimit ' ~ site.request_body_limit]
              if site.request_body_limit | int != waf_request_body_limit | int else [])
           + (exclusion_rules(root_exclusion[0]) | from_json if root_exclusion | length > 0 else []), '    ') }}
{% endif %}
{% if site.mode == 'detect' %}
    error_page 418 = @waf_uninspected;

    # A body ModSecurity does not get: it passes without its checks.
    location @waf_uninspected {
      modsecurity off;
      proxy_pass $waf_backend;
    }
{% endif %}

    location / {
{% if site.mode == 'detect' %}
{{ uninspected_checks(site, '      ') }}
{% endif %}
      proxy_pass $waf_backend;
    }
{% for path in site.bypass_paths %}

    # Not inspected, so not limited either.
    location ^~ {{ path }} {
{{ raw_path_checks(path, '      ') }}
      modsecurity off;
      client_max_body_size 0;
      proxy_pass $waf_backend;
    }
{% endfor %}
{% for exclusion in site.exclusions if exclusion.path != '/' %}

    location ^~ {{ exclusion.path }} {
{{ raw_path_checks(exclusion.path, '      ') }}
{% if site.mode == 'detect' %}
{{ uninspected_checks(site, '      ') }}
{% endif %}
{{ rules(exclusion_rules(exclusion) | from_json, '      ') }}
      proxy_pass $waf_backend;
    }
{% endfor %}
  }
{% endfor %}
}
