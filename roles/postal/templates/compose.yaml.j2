{#- Values go through to_json (a valid YAML string) with $ doubled, which
    compose would otherwise interpolate. No secret is in this file: Postal
    reads them from postal.yml and signing.key of postal_config_dir, bound
    read-only; the own MariaDB has no password of its own (root logs in
    through its socket only, the role creates Postal's user). -#}
{%- macro q(value) -%}{{ (value | string | replace('$', '$$')) | to_json }}{%- endmacro -%}
{#- A bind mount that compose must not create: a missing data directory (an
    unmounted volume) stops the container instead of starting it empty. -#}
{%- macro bind(source, target, read_only=false, indent=6) %}
{{ ' ' * indent }}- type: bind
{{ ' ' * indent }}  source: {{ q(source) }}
{{ ' ' * indent }}  target: {{ q(target) }}
{{ ' ' * indent }}  read_only: {{ 'true' if read_only else 'false' }}
{{ ' ' * indent }}  bind:
{{ ' ' * indent }}    create_host_path: false
{%- endmacro %}
{%- set own_db = postal_database == 'mariadb' -%}
{#- The routers of web: the public API (and the key of the webhook
    signatures), the UI on entrypoints of its own (everything else of the web
    host name), tracking on the role-known tracking host and
    postal_track_hostnames (with the entrypoint's certificates), and tracking
    on the customer tracking domains Postal verified (state.yml), outside the
    operator's DNS zone, with the HTTP-01 resolver
    postal_traefik_track_cert_resolver; without such a domain that router is
    left out (a Host rule needs a host). Postal answers as its tracking server
    whenever a request carries X-Postal-Track-Host: 1, and Puma reads every
    spelling of it with dashes or underscores as that header unless the
    all-dash one is there. So the routers of the web host name set the all-dash one to 0,
    which outweighs any spelling a client sends, and only the tracking router
    sets it to 1. -#}
{%- set router = postal_project -%}
{%- set host_rule = 'Host(`' ~ postal_web_hostname ~ '`)' -%}
{%- set api_paths = 'PathPrefix(`/api/`) || Path(`/.well-known/jwks.json`)' -%}
{%- set track_names = ([postal_dns_settings.track_domain] + postal_track_hostnames) | map('string') | unique | list -%}
{%- set track_rules = [] -%}
{%- for name in track_names -%}
{%-   set _ = track_rules.append('Host(`' ~ name ~ '`)') -%}
{%- endfor -%}
{%- set customer_rules = [] -%}
{%- for name in postal_track_domains if name | lower not in track_names | map('lower') | list -%}
{%-   set _ = customer_rules.append('Host(`' ~ name ~ '`)') -%}
{%- endfor -%}
{%- set strip = router ~ '-strip-track' -%}
{%- set set_track = router ~ '-set-track' -%}
{%- set routers = [
  {'name': router ~ '-api', 'rule': host_rule ~ ' && (' ~ api_paths ~ ')',
   'entrypoints': postal_traefik_entrypoints, 'priority': postal_traefik_priority | int + 1,
   'middlewares': [strip] + postal_traefik_middlewares},
  {'name': router ~ '-ui', 'rule': host_rule ~ ' && !(' ~ api_paths ~ ')',
   'entrypoints': postal_traefik_ui_entrypoints, 'priority': postal_traefik_priority | int,
   'middlewares': [strip] + postal_traefik_ui_middlewares},
  {'name': router ~ '-track', 'rule': track_rules | join(' || '),
   'entrypoints': postal_traefik_entrypoints, 'priority': postal_traefik_priority | int + 1,
   'middlewares': [set_track] + postal_traefik_track_middlewares},
] -%}
{%- if customer_rules | length > 0 -%}
{%-   set _ = routers.append(
  {'name': router ~ '-track-customers', 'rule': customer_rules | join(' || '),
   'entrypoints': postal_traefik_entrypoints, 'priority': postal_traefik_priority | int + 1,
   'middlewares': [set_track] + postal_traefik_track_middlewares,
   'certresolver': postal_traefik_track_cert_resolver}) -%}
{%- endif -%}
{#- With postal_smtp_tls traefik, Traefik obtains and renews the certificate
    of the SMTP services only for a host name a router names, with the
    resolver of the entrypoints: a host name of their own gets a router of its
    own, with the API's paths alone (never the UI, which may sit behind other
    entrypoints and middlewares) and the API's middlewares. -#}
{%- if postal_smtp_tls == 'traefik' and postal_smtp_hostname | lower != postal_web_hostname | lower -%}
{%-   set _ = routers.append(
  {'name': router ~ '-smtp', 'rule': 'Host(`' ~ postal_smtp_hostname ~ '`) && (' ~ api_paths ~ ')',
   'entrypoints': postal_traefik_entrypoints, 'priority': postal_traefik_priority | int + 1,
   'middlewares': [strip] + postal_traefik_middlewares}) -%}
{%- endif -%}
# Managed by the noixdev.infra.postal role; changes are overwritten.

# What every Postal service shares: the image (linux/amd64 only; the role
# refuses other hosts unless a test lifts the check), the configuration
# directory read-only, and the grace Postal needs to finish what it handles
# on SIGTERM.
x-postal: &postal
  image: {{ q(postal_image ~ ':' ~ postal_version) }}
  platform: linux/amd64
  volumes:
{{ bind(postal_config_dir, '/config', read_only=true, indent=4) }}
  stop_grace_period: 60s
  restart: unless-stopped
{% if own_db %}
  depends_on:
    mariadb:
      condition: service_healthy
{% endif %}
{% if own_db %}

# The services on the host's network reach the own MariaDB at its published
# port on 127.0.0.1, under the name web uses on the project network.
x-host-network: &host-network
  network_mode: host
  extra_hosts:
    - {{ q(postal_mariadb_host ~ ':127.0.0.1') }}
{% else %}

x-host-network: &host-network
  network_mode: host
{% endif %}

services:
{% if own_db %}
  # The own MariaDB on the project network, published on 127.0.0.1 only (for
  # the services on the host's network), listening on the same port inside.
  # Its settings come from mariadb.cnf; the label changes with them, so that
  # a change recreates the container. Root has no password: the role switches
  # it to the socket on install, which only a command inside the container
  # reaches.
  mariadb:
    image: {{ q(postal_mariadb_image) }}
    environment:
      MARIADB_ALLOW_EMPTY_ROOT_PASSWORD: "1"
      MARIADB_ROOT_HOST: localhost
      MARIADB_AUTO_UPGRADE: "1"
    volumes:
{{ bind(postal_data_dir ~ '/mariadb', '/var/lib/mysql') }}
{{ bind(postal_mariadb_cnf_file, '/etc/mysql/conf.d/postal.cnf', read_only=true) }}
    ports:
      - {{ q('127.0.0.1:' ~ postal_mariadb_port ~ ':' ~ postal_mariadb_port) }}
    networks:
      default:
        aliases:
          - {{ q(postal_mariadb_host) }}
    labels:
      - {{ q('noixdev.postal.mariadb-cnf=' ~ (postal_mariadb_cnf | hash('sha256'))) }}
    healthcheck:
      test: [CMD, healthcheck.sh, --connect, --innodb_initialized]
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 120s
      start_interval: 5s
    stop_grace_period: 60s
    restart: unless-stopped

{% endif %}
  # The web interface, the API and tracking, on 0.0.0.0:5000 (postal.yml) of
  # the project network and the Traefik network; no published port: Traefik
  # reaches it over its network.
  web:
    <<: *postal
    command: [postal, web-server]
    networks: [default, traefik]
    labels:
      - traefik.enable=true
      - {{ q('traefik.docker.network=' ~ postal_traefik_network) }}
      - {{ q('traefik.http.middlewares.' ~ strip ~ '.headers.customrequestheaders.X-Postal-Track-Host=0') }}
      - {{ q('traefik.http.middlewares.' ~ set_track ~ '.headers.customrequestheaders.X-Postal-Track-Host=1') }}
{% for r in routers %}
      - {{ q('traefik.http.routers.' ~ r.name ~ '.rule=' ~ r.rule) }}
{%   if r.entrypoints | length > 0 %}
      - {{ q('traefik.http.routers.' ~ r.name ~ '.entrypoints=' ~ r.entrypoints | join(',')) }}
{%   endif %}
      - {{ q('traefik.http.routers.' ~ r.name ~ '.priority=' ~ r.priority) }}
      - {{ q('traefik.http.routers.' ~ r.name ~ '.middlewares=' ~ r.middlewares | join(',')) }}
      - {{ q('traefik.http.routers.' ~ r.name ~ '.service=' ~ router) }}
{%   if r.certresolver is defined %}
      - {{ q('traefik.http.routers.' ~ r.name ~ '.tls.certresolver=' ~ r.certresolver) }}
{%   endif %}
{% endfor %}
      # Plain HTTP stays on the compose networks; Traefik terminates TLS.
      - {{ q('traefik.http.services.' ~ router ~ '.loadbalancer.server.port=5000') }}

  # The SMTP server on the host's network, so that it sees the real client
  # addresses; its health server on 127.0.0.1.
  smtp:
    <<: [*postal, *host-network]
    command: [postal, smtp-server]
    cap_add: [NET_BIND_SERVICE]
    environment:
      PORT: {{ q(postal_smtp_port | int) }}
      HEALTH_SERVER_PORT: {{ q(postal_smtp_health_port | int) }}
{% if postal_smtp_submission_port | int != 0 %}

  # The same server on the submission port, for clients whose provider blocks
  # outgoing port 25.
  submission:
    <<: [*postal, *host-network]
    command: [postal, smtp-server]
    cap_add: [NET_BIND_SERVICE]
    environment:
      PORT: {{ q(postal_smtp_submission_port | int) }}
      HEALTH_SERVER_PORT: {{ q(postal_submission_health_port | int) }}
{% endif %}

  # Delivery and the other background work, on the host's network (IP
  # pools bind addresses of the host). A second replica finds the health port
  # taken and runs without a health server.
  worker:
    <<: [*postal, *host-network]
    command: [postal, worker]
    deploy:
      replicas: {{ postal_worker_replicas | int }}

  # One-off commands (docker compose run --rm runner postal <command>): the
  # database setup, the first admin, the DKIM record, the role's checks.
  runner:
    <<: *postal
    profiles: [tools]
    command: [postal]
    restart: "no"
    networks: [default, traefik]

networks:
  traefik:
    name: {{ q(postal_traefik_network) }}
    external: true
